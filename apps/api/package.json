{
  "name": "@bubrolinguo/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:api": "tsx src/test-api.ts",
    "lint": "eslint src --ext .ts",
