# Frontend Environment Variables
# Copy this file to .env.local to use

# ============================================
# MOCK DATA MODE
# ============================================
# Set to 'true' to use mock data instead of real API
# Useful for frontend development without backend
NEXT_PUBLIC_USE_MOCK_DATA=true

# ============================================
# API Configuration
# ============================================
# Backend API URL (only used when mock data is disabled)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Authentication
# ============================================
# JWT token storage key
NEXT_PUBLIC_AUTH_TOKEN_KEY=bubrolinguo_auth_token

# ============================================
# Feature Flags
# ============================================
# Enable audio features (requires Google Cloud TTS setup)
NEXT_PUBLIC_AUDIO_ENABLED=false

# Enable social features (friends, leaderboards)
NEXT_PUBLIC_SOCIAL_ENABLED=true

# Enable achievement notifications
NEXT_PUBLIC_ACHIEVEMENTS_ENABLED=true

# ============================================
# Analytics (Optional)
# ============================================
# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# External Services (Optional)
# ============================================
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Development Settings
# ============================================
# Show debug information in console
NEXT_PUBLIC_DEBUG=false

# ============================================
# USAGE NOTES
# ============================================
#
# Mock Data Mode:
#   - Set NEXT_PUBLIC_USE_MOCK_DATA=true for development
#   - All API calls will use mock data from lib/mockData.ts
#   - Network delays are simulated for realistic testing
#   - Perfect for UI development and component testing
#
# Production Mode:
#   - Set NEXT_PUBLIC_USE_MOCK_DATA=false
#   - Ensure NEXT_PUBLIC_API_URL points to your backend
#   - Make sure backend is running and accessible
#
# After changing environment variables:
#   - Restart Next.js dev server (npm run dev)
#   - Clear browser cache if needed
#
# For more information:
#   - See lib/MOCK_DATA_USAGE.md for mock data documentation
#   - See lib/mockData.ts for available mock data
#   - See services/*.service.ts for service implementations
